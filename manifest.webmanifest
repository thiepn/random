{
  "name": "Randomizer Arcade",
  "short_name": "Random",
  "description": "A vibrant arcade of randomizers and decision tools.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090b14",
  "theme_color": "#0a0c18",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    { "name": "Flip Coin", "url": "./?tool=coin", "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Roll Dice", "url": "./?tool=dice", "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Spin Wheel", "url": "./?tool=wheel", "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ]
}
